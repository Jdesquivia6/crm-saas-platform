}

model PaymentTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  intentId        String   @map("intent_id") @db.Uuid
  type            String   @db.VarChar(30) // AUTHORIZATION, CAPTURE, TRANSFER, FEE
  status          String   @default("PENDING") @db.VarChar(30) // PENDING, SUCCEEDED, FAILED
  amount          Decimal  @db.Decimal(14, 2)
  currencyCode    String   @default("COP") @map("currency_code") @db.VarChar(3)
  providerRef     String?  @map("provider_ref") @db.VarChar(200)
  feeAmount       Decimal? @map("fee_amount") @db.Decimal(14, 2)
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([intentId])
  @@map("payment_transactions")
}

model Refund {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  intentId        String   @map("intent_id") @db.Uuid
  number          String   @db.VarChar(30)
  status          String   @default("PENDING") @db.VarChar(30) // PENDING, SUCCEEDED, FAILED, CANCELLED
  amount          Decimal  @db.Decimal(14, 2)
  currencyCode    String   @default("COP") @map("currency_code") @db.VarChar(3)
  reason          String?  @db.VarChar(500)
  providerRef     String?  @map("provider_ref") @db.VarChar(200)
  metadata        Json?
  processedAt     DateTime? @map("processed_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([intentId])
  @@map("refunds")
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String   @db.VarChar(200)
  endpoint    String   @db.VarChar(200)
  statusCode  Int      @map("status_code")
  response    Json
  expiresAt   DateTime @map("expires_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([tenantId, key, endpoint])
  @@index([tenantId])
  @@index([key, endpoint])
  @@map("idempotency_keys")
}
