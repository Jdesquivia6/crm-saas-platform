model ContactConsent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  contactId    String   @map("contact_id") @db.Uuid
  channel      String   @db.VarChar(30) // EMAIL, SMS, WHATSAPP, PHONE, PUSH, ADS
  status       String   @default("GRANTED") @db.VarChar(20) // GRANTED, DENIED, WITHDRAWN, PENDING
  grantedAt    DateTime? @map("granted_at") @db.Timestamptz()
  deniedAt     DateTime? @map("denied_at") @db.Timestamptz()
  withdrawnAt  DateTime? @map("withdrawn_at") @db.Timestamptz()
  source       String?  @db.VarChar(50) // WEB_FORM, API, IMPORT, MANUAL
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  legalBasis   String?  @map("legal_basis") @db.VarChar(50) // CONSENT, LEGITIMATE_INTEREST, CONTRACT, LEGAL_OBLIGATION
  purpose      String?  @db.VarChar(200)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz()
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId, channel])
  @@index([tenantId])
  @@index([contactId])
  @@map("contact_consents")
}

model CustomField {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(30) // CONTACT, COMPANY, LEAD
  fieldName    String   @map("field_name") @db.VarChar(100)
  fieldType    String   @map("field_type") @db.VarChar(30) // TEXT, NUMBER, DATE, SELECT, MULTI_SELECT, BOOLEAN, EMAIL, PHONE, URL, CURRENCY
  label        String   @db.VarChar(200)
  description  String?  @db.VarChar(500)
  isRequired   Boolean  @default(false) @map("is_required")
  isVisible    Boolean  @default(true) @map("is_visible")
  defaultValue Json?    @map("default_value")
  validation   Json?    // { min, max, pattern, options }
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options CustomFieldOption[]
  values  ContactCustomValue[]

  @@unique([tenantId, entityType, fieldName])
  @@index([tenantId])
  @@index([tenantId, entityType])
  @@map("custom_fields")
}

model CustomFieldOption {
  id            String  @id @default(uuid()) @db.Uuid
  customFieldId String  @map("custom_field_id") @db.Uuid
  value         String  @db.VarChar(200)
