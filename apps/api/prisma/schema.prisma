model Conversation {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  contactId    String?  @map("contact_id") @db.Uuid
  channelType  String   @map("channel_type") @db.VarChar(30)
  channelAccountId String? @map("channel_account_id") @db.Uuid
  externalId   String?  @map("external_id") @db.VarChar(250)
  subject      String?  @db.VarChar(250)
  status       String   @default("OPEN") @db.VarChar(20) // OPEN, PENDING, RESOLVED, CLOSED
  priority     String   @default("NORMAL") @db.VarChar(10) // LOW, NORMAL, HIGH, URGENT
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz()
  lastMessagePreview String? @map("last_message_preview") @db.VarChar(500)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
